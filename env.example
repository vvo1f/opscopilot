# Copy this file to .env (cp env.example .env  /  copy env.example .env) and edit it.
# .env is ignored by git, so your key never goes to GitHub.

# --- LLM: Google Gemini free tier, through its OpenAI-compatible endpoint ---
# Create a key in Google AI Studio. For LLM_MODEL copy the exact id of a "Flash"
# model from the AI Studio model list (ids change over time).
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=<api-key>
LLM_MODEL=gemini-2.5-flash

# --- Offline fallback: Ollama (ollama pull qwen2.5:3b) ---
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=qwen2.5:3b

# --- Other free option: Groq ---
# LLM_BASE_URL=https://api.groq.com/openai/v1

# --- Embeddings run locally. e5-small is ~470 MB and 384-dim ---
EMBEDDING_MODEL=intfloat/multilingual-e5-small
# EMBEDDING_MODEL=intfloat/multilingual-e5-base and EMBEDDING_DIM=768 (about 1.1 GB, still fine for your laptop)
EMBEDDING_DIM=384

# --- Databases (app db is on host port 5434 because 5432 is often taken) ---
DATABASE_URL=postgresql://opscopilot:opscopilot@localhost:5434/opscopilot
GEO_DATABASE_URL=postgresql://geo_admin:geo_admin@localhost:5433/geo
